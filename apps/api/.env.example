PORT=4000
# Keep zero locally; Render's Blueprint sets one trusted ingress proxy hop.
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/along
JWT_SECRET=
CORS_ORIGINS=http://localhost:8081
ADMIN_ORIGIN=http://localhost:3000
# Use env for email/password login (including production), or mfa for optional authenticator login.
ADMIN_AUTH_MODE=mfa
# ADMIN_EMAIL=your-admin-email@example.com
# ADMIN_PASSWORD=choose-at-least-six-characters
# ADMIN_NAME=Along Admin
# Generate a dedicated 32-byte hex key; keep stable and secret. Encrypts admin MFA secrets.
ADMIN_ENCRYPTION_KEY=
NODE_ENV=development
SMTP_URL=
# Set false temporarily to allow unverified emails without changing emailVerified.
EMAIL_VERIFICATION_REQUIRED=true
# Free Brevo SMTP alternative to SMTP_URL (SMTP key, not the API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Verified sender for contact-verification emails, e.g. Along <hello@yourdomain.com>
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
# auto uses Cloudinary when credentials are present; mongodb retains local database storage.
PHOTO_STORAGE=auto
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
# Private local Social photo storage when Cloudinary is not configured.
# Never expose this directory through a static server. Production should use authenticated Cloudinary.
SOCIAL_MEDIA_DIR=.social-media
