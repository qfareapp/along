{
  "name": "@along/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "dev:local": "tsx src/dev-local.ts",
    "dev:local:admin": "tsx src/dev-local.ts --admin",
    "admin:bootstrap": "tsx src/admin/bootstrap.ts",
    "qa:admin": "tsx src/admin/browser-qa.ts",
    "qa:admin:simple": "tsx src/admin/browser-qa.ts --env-login",
    "qa:onboarding": "tsx src/onboarding-browser-qa.ts",
    "email:check": "tsx src/email-check.ts",
    "cloudinary:check": "tsx src/cloudinary-check.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
